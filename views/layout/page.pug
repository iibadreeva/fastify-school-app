html
    head
        meta(charset='utf-8')
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title My Site
        link(rel="stylesheet" href="/assets/bootstrap.min.css")
    body
        .container.min-vh-100.flex-column.justify-content-between.d-flex.p-0.my-0
            div
                header.bg-light.border-bottom.py-3.mb-4
                    div.container.d-flex.justify-content-between.align-items-center
                        span.fw-bold.text-primary
                            a(href=reverse(RouteNames.HOME)) Главная
                        nav.d-flex.gap-3
                            a(href=reverse(RouteNames.USERS_INDEX)) Пользователи
                            a(href=reverse(RouteNames.COURSES_INDEX)) Курсы
                            a(href=reverse(RouteNames.TEST)) Тесты

                block content
            block footer
                #footer.text-center
                    p some footer content
html
    head
        meta(charset='utf-8')
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title My Site
        link(rel="stylesheet" href="/assets/bootstrap.min.css")
    body
        .container.min-vh-100.flex-column.justify-content-between.d-flex.p-0.my-0
            div
                header.bg-light.border-bottom.py-3.mb-4
                    div.container.d-flex.justify-content-between.align-items-center
                        span.fw-bold.text-primary
                            a(href=reverse(RouteNames.HOME)) Главная
                        nav.d-flex.gap-3.align-items-center
                            a(href=reverse(RouteNames.USERS_INDEX)) Пользователи
                            a(href=reverse(RouteNames.COURSES_INDEX)) Курсы
                            a(href=reverse(RouteNames.TEST)) Тесты
                            if currentUser
                                a(href=reverse(RouteNames.AUTH_PROFILE))= currentUser.username
                                form.d-inline.mb-0(method="POST" action=reverse(RouteNames.AUTH_LOGOUT))
                                    button.btn.btn-link.p-0.border-0(type="submit") Выход
                            else
                                a(href=reverse(RouteNames.AUTH_LOGIN)) Вход
                                a(href=reverse(RouteNames.AUTH_REGISTER)) Регистрация

                //- Bootstrap alerts: success — зелёный, error — красный (@fastify/flash)
                if flashMessages && flashMessages.length
                    .container.mb-3
                        each msg in flashMessages
                            div.alert(class=msg.alertClass role="alert")= msg.text

                block content
            block footer
                #footer.text-center
                    p some footer content
extends ../layout/page

block content
  h1= user.username
  p
    strong Email:
    |
    = user.email
  .mt-3
    a.btn.btn-primary(href=reverse(RouteNames.EDIT_USER, { id: user.id })) Редактировать
    a.btn.btn-secondary.ms-2(href=reverse(RouteNames.USERS_INDEX)) ← К списку
  hr.my-4
  form(method="POST" action=reverse(RouteNames.DELETE_USER, { id: user.id }) onsubmit="return confirm('Удалить пользователя?')")
    input(type="hidden" name="_method" value="DELETE")
    button.btn.btn-danger(type="submit") Удалить пользователя

extends ../layout/page

block content
  h1.mb-4 Пользователи
  a.btn.btn-primary.mb-4(href=reverse(RouteNames.NEW_USER)) Новый пользователь
  table.table.table-striped.table-hover
    thead
      tr
        th Имя
        th Email
        th password
    tbody
      each user in users
        tr
          td
            a(href=reverse(RouteNames.SHOW_USER, { id: user.id }))= user.username
          td= user.email
          td= user.password

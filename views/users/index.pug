extends ../layout/page

block content
  h1.mb-4 Пользователи
  a.btn.btn-primary.mb-4(href="/users/new") Новый пользователь
  table.table.table-striped.table-hover
    thead
      tr
        th Имя
        th Email
    tbody
      each user in users
        tr
          td
            a(href=`/users/${user.id}`)= user.username
          td= user.email

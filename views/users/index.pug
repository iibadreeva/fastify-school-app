extends ../layout/page

block content
  h1.mb-4 Пользователи
  a.btn.btn-primary.mb-4(href=reverse(RouteNames.NEW_USER)) Новый пользователь
  table.table.table-striped.table-hover
    thead
      tr
        th Имя
        th Email
        th password
        th.text-end Действия
    tbody
      each user in users
        tr
          td
            a(href=reverse(RouteNames.SHOW_USER, { id: user.id }))= user.username
          td= user.email
          td= user.password
          td.text-end
            a.btn.btn-sm.btn-outline-primary.me-1(href=reverse(RouteNames.EDIT_USER, { id: user.id })) Редактировать
            form.d-inline(method="POST" action=reverse(RouteNames.DELETE_USER, { id: user.id }) onsubmit="return confirm('Удалить пользователя?')")
              input(type="hidden" name="_method" value="DELETE")
              button.btn.btn-sm.btn-outline-danger(type="submit") Удалить
  .text-center
    if totalPages > 1
      p.text-muted.mb-3 Страница #{page} из #{totalPages}
    nav.mb-3(aria-label="Пагинация пользователей")
      if hasPrev
        a.btn.btn-outline-secondary.me-2(href=prevUrl) ← Назад
      else
        span.btn.btn-outline-secondary.me-2.disabled ← Назад
      if hasNext
        a.btn.btn-outline-secondary(href=nextUrl) Вперёд →
      else
        span.btn.btn-outline-secondary.disabled Вперёд →

extends ../layout/page

block content
  h1.mb-4 Новый пользователь
  form(method="POST" action="/users")
    .mb-3
      label.form-label(for="username") Имя пользователя
      input.form-control#username(type="text" name="username" required)
    .mb-3
      label.form-label(for="email") Email
      input.form-control#email(type="email" name="email" required)
    button.btn.btn-primary(type="submit") Добавить
    a.btn.btn-secondary.ms-2(href="/users") Отмена

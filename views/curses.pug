extends layout/page
block content
    h1= header
    form.mb-4(method="POST" action="/courses")
        .row.g-3.mb-3
            .col-md-5
                input.form-control(type="text" name="title" placeholder="Название курса" required)
            .col-md-5
                input.form-control(type="text" name="description" placeholder="Описание курса" required)
            .col-md-2
                button.btn.btn-primary.w-100(type="submit") Добавить
    form.mb-4(method="GET" action="/courses")
        .input-group
            input.form-control(
                type="search"
                name="q"
                value=filterQuery
                placeholder="Поиск по названию или описанию"
            )
            button.btn.btn-primary(type="submit") Найти
    if courses.length === 0
        if filterQuery
            p Курсы не найдены
        else
            p Пока не добавлено ни одного курса
    else
        each course in courses
            div
                h2
                    a(href=`/courses/${course.id}/lessons/1`)= course.title
                p= course.description

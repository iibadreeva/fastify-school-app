extends ../layout/page

block content
  h1.mb-4 Новый курс
  form(method="POST" action="/courses")
    .mb-3
      label.form-label(for="title") Название курса
      input.form-control#title(type="text" name="title" required)
    .mb-3
      label.form-label(for="description") Описание курса
      input.form-control#description(type="text" name="description" required)
    button.btn.btn-primary(type="submit") Добавить
    a.btn.btn-secondary.ms-2(href="/courses") Отмена

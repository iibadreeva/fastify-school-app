extends ../layout/page
block content
    h1= header
    a.btn.btn-primary.mb-4(href=reverse(RouteNames.NEW_COURSE)) Новый курс
    form.mb-4(method="GET" action=reverse(RouteNames.COURSES_INDEX))
        .input-group
            input.form-control(
                type="search"
                name="q"
                value=filterQuery
                placeholder="Поиск по названию или описанию"
            )
            button.btn.btn-primary(type="submit") Найти
    if courses.length === 0
        if filterQuery
            p Курсы не найдены
        else
            p Пока не добавлено ни одного курса
    else
        each course in courses
            div.mb-4.pb-3.border-bottom
                h2
                    a(href=reverse(RouteNames.SHOW_COURSE, { id: course.id }))= course.title
                p= course.description
                .mt-2
                    a.btn.btn-sm.btn-outline-primary.me-1(href=reverse(RouteNames.EDIT_COURSE, { id: course.id })) Редактировать
                    form.d-inline(method="POST" action=reverse(RouteNames.DELETE_COURSE, { id: course.id }) onsubmit="return confirm('Удалить курс?')")
                        input(type="hidden" name="_method" value="DELETE")
                        button.btn.btn-sm.btn-outline-danger(type="submit") Удалить

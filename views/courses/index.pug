extends ../layout/page
block content
    h1= header
    a.btn.btn-primary.mb-4(href=reverse(RouteNames.NEW_COURSE)) Новый курс
    form.mb-4(method="GET" action=reverse(RouteNames.COURSES_INDEX))
        .input-group
            input.form-control(
                type="search"
                name="q"
                value=filterQuery
                placeholder="Поиск по названию или описанию"
            )
            button.btn.btn-primary(type="submit") Найти
    if courses.length === 0
        if filterQuery
            p Курсы не найдены
        else
            p Пока не добавлено ни одного курса
    else
        each course in courses
            div
                h2
                    a(href=reverse(RouteNames.COURSE_LESSON, { id: course.id, postId: 1 }))= course.title
                p= course.description
